<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.bami.repurposer.digest</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/bami/repurpose content/.venv/bin/python</string>
        <string>/Users/bami/repurpose content/worker.py</string>
        <string>--digest</string>
    </array>
    <key>WorkingDirectory</key><string>/Users/bami/repurpose content</string>
    <key>StartCalendarInterval</key>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    <key>EnvironmentVariables</key>
    <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
    <key>StandardOutPath</key><string>/Users/bami/repurpose content/logs/launchd-digest.out.log</string>
    <key>StandardErrorPath</key><string>/Users/bami/repurpose content/logs/launchd-digest.err.log</string>
</dict>
</plist>
