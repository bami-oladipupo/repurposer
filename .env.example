# Copy to .env and fill in. Never commit .env.

# Telegram alerts (notify.method: telegram). Create a bot via @BotFather, then message it once
# and read your chat ID from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email alerts (notify.method: email). Optional.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=

# YouTube: path to the OAuth desktop client secret downloaded from Google Cloud Console.
YOUTUBE_CLIENT_SECRET_FILE=tokens/client_secret.json

# Instagram API with Instagram Login: from the Meta developer app (Instagram product).
IG_APP_ID=
IG_APP_SECRET=
# Must match the redirect URI registered in the Meta app. Default works for a local web app.
IG_REDIRECT_URI=https://bami-oladipupo.github.io/repurposer/oauth/instagram/callback/

# Web app bind. Keep 127.0.0.1 unless you sit behind Tailscale or a basic-auth proxy.
WEB_HOST=127.0.0.1
WEB_PORT=8080

# Claude API key for caption rewriting (console.anthropic.com). Leave blank to keep templates only.
ANTHROPIC_API_KEY=

# Cloudflare R2: Instagram fetches each Reel from a public URL, so the file is staged in this
# bucket for the minutes Meta needs and deleted once the Reel is published.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=repurposer-media
R2_PUBLIC_BASE_URL=

# IV Repost iPhone app: every /api/app request must send this as a Bearer token. Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# To let the phone reach the Mac, set WEB_HOST=0.0.0.0 above; the web pages still answer only to the Mac.
APP_TOKEN=

# Push alerts to the IV Repost app: Apple push auth key (.p8), its key ID, the team ID and the app's bundle ID.
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.bami.ivrepost
